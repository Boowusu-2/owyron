# OWYRON Environment Configuration
# Copy these keys into Vercel -> Project Settings -> Environment Variables

# Primary / General enquiries email address
VITE_CONTACT_EMAIL=support@owyron.com

# Optional dedicated addresses (defaults to VITE_CONTACT_EMAIL if left blank)
VITE_PARTNERSHIP_EMAIL=info@owyron.com
VITE_COLLABORATION_EMAIL=info@owyron.com

# Optional HTTP POST endpoint for contact form submissions (e.g. Formspree, Web3Forms, or custom API)
# When empty, the form dispatches via mailto: using the configured email above.
VITE_CONTACT_FORM_ENDPOINT=

# Canonical production URL (optional, e.g. https://owyron.com)
VITE_SITE_URL=https://owyron.com

